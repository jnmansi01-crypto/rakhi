rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /experiences/{experienceId}/{allPaths=**} {
      // Anyone can read media
      allow read: if true;
      // Writing requires authentication, and we check firestore to see if the user is the creator
      allow write: if request.auth != null && 
                   firestore.get(/databases/(default)/documents/experiences/$(experienceId)).data.creatorUid == request.auth.uid &&
                   request.resource.size < 5 * 1024 * 1024 && // 5MB limit
                   request.resource.contentType.matches('image/.*|audio/.*|video/.*');
    }
  }
}
